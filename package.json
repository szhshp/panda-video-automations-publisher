{
  "name": "@panda-video-automation/pva",
  "version": "0.1.7",
  "description": "Playwright-based video upload automation for Bilibili, Douyin, Kuaishou, Weixin Video, and YouTube",
  "bin": {
    "pva": "./bin/pva.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "bin/",
    "dist/",
    "playwright.config.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "login:bilibili": "pva bilibili login",
    "login:douyin": "pva douyin login",
    "login:kuaishou": "pva kuaishou login",
    "login:weixin": "pva weixin login",
    "login:youtube": "pva youtube login",
    "upload:bilibili": "pva bilibili upload",
    "upload:douyin": "pva douyin upload",
    "upload:kuaishou": "pva kuaishou upload",
    "upload:weixin": "pva weixin upload",
    "upload:youtube": "pva youtube upload",
    "upload:all": "pva bilibili upload && pva douyin upload && pva kuaishou upload && pva weixin upload && pva youtube upload",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "^1.58.0",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "20.12.14",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "preferUnplugged": true,
  "author": {
    "name": "szhshp",
    "url": "https://github.com/szhshp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szhshp/panda-video-automations-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/szhshp/panda-video-automations-publisher/issues"
  },
  "homepage": "https://github.com/szhshp/panda-video-automations-publisher",
  "keywords": [
    "playwright",
    "video",
    "upload",
    "automation",
    "bilibili",
    "douyin",
    "kuaishou",
    "weixin",
    "youtube"
  ],
  "license": "MIT"
}
